{
  "name": "@relay/node",
  "version": "0.1.4",
  "description": "Relay independent execution node and SDK",
  "type": "module",
  "main": "dist/sdk.js",
  "types": "dist/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "import": "./dist/rules.js"
    },
    "./browser": {
      "types": "./dist/apps/worker/src/browser/actions.d.ts",
      "import": "./dist/apps/worker/src/browser/actions.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "install.sh",
    "scripts/install-reference-sentinel.mjs",
    "scripts/probe-reference-sentinel.mjs",
    "VERSION"
  ],
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsx --test tests/*/*.test.ts",
    "native:build": "node scripts/build-native.mjs",
    "sentinel:install-reference": "node scripts/install-reference-sentinel.mjs",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "typescript": "6.0.3",
    "tsx": "4.19.4"
  }
}
